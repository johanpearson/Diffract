<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>diffract-sidecar</AssemblyName>
    <RootNamespace>Diffract.Sidecar</RootNamespace>
    <Version>0.1.0</Version>
    <PublishAot>true</PublishAot>
    <!-- Only for the code LibraryImport generates, the Native AOT way to call Windows (ProcessTable.cs). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Diffract.Sidecar.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Diffract.Git\Diffract.Git.csproj" />
    <ProjectReference Include="..\Diffract.Leftovers\Diffract.Leftovers.csproj" />
  </ItemGroup>

</Project>
