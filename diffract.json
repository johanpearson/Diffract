{
  "mainBranch": "auto",
  "staleAfterDays": 7,
  "activeWithinMinutes": 10,
  "archive": {
    "tagPrefix": "archive/",
    "reviewAfterDays": 30
  },
  "agents": [
    {
      "name": "Claude Code",
      "branchPatterns": [ "claude/*" ],
      "worktreePathPatterns": [ "**/.claude/worktrees/**" ],
      "refPatterns": [ ]
    },
    {
      "name": "GitHub Copilot",
      "branchPatterns": [ "copilot/*", "copilot-prewarm-*" ],
      "worktreePathPatterns": [ "**/copilot-worktrees/**" ],
      "refPatterns": [ "refs/copilot/checkpoints/**" ]
    }
  ],
  "checkpointRefPatterns": [ "refs/copilot/checkpoints/**", "refs/checkpoints/**" ],
  "toolStashPatterns": [ "autostash", "claude", "copilot" ]
}
