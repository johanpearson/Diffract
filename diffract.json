{
  "mainBranch": "auto",
  "staleAfterDays": 7,
  "activeWithinMinutes": 10,
  "archive": {
    "tagPrefix": "archive/",
    "reviewAfterDays": 30
  },
  "agents": [
    {
      "name": "Claude Code",
      "branchPatterns": [ "claude/*" ],
      "worktreePathPatterns": [ "**/.claude/worktrees/**" ],
      "refPatterns": [ ],
      "commitSubjectPrefixes": [ ]
    },
    {
      "name": "GitHub Copilot",
      "branchPatterns": [ "copilot/*" ],
      "worktreePathPatterns": [ "**/copilot-worktrees/**" ],
      "refPatterns": [ "refs/copilot/checkpoints/**" ],
      "commitSubjectPrefixes": [ "Agent host session ", "copilot checkpoint: ", "copilot:dirty-archive:" ]
    }
  ],
  "checkpointRefPatterns": [ "refs/copilot/checkpoints/**", "refs/checkpoints/**" ],
  "checkpointCommitPrefixes": [ "copilot checkpoint: ", "copilot:dirty-archive:" ],
  "hiddenWorktreePathPatterns": [ "**/copilot-worktrees/*/copilot-prewarm-*" ],
  "worktreeContainerPatterns": [ "**/copilot-worktrees/*", "**/.claude/worktrees" ],
  "toolStashPatterns": [ "autostash", "claude", "copilot" ],
  "remoteBranchPatterns": [ "claude/*", "copilot/*" ]
}
